{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackRack Overlay",
  "version": "0.6.1",
  "identifier": "com.blackrack.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:6398; img-src 'self' asset: data:; style-src 'self'"
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Overlays de telemetría para Le Mans Ultimate",
    "longDescription": "Overlays de telemetría, standings, estrategia de combustible y energía, banderas y avisos para Le Mans Ultimate.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "template": "nsis-installer.nsi"
      }
    }
  }
}
