{
  "name": "blackrack-overlay",
  "private": true,
  "version": "0.7.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:i18n": "node tools/validate-i18n.mjs && node tools/audit-visible-copy.mjs",
    "check:overlays": "node tools/validate-overlays.mjs",
    "build": "npm run check:i18n && npm run check:overlays && tsc && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features experimental-simulators",
    "icons:raster": "node tools/rasterize-icons.mjs"
  },
  "dependencies": {
    "@fontsource/roboto-condensed": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "sharp": "^0.35.4",
    "terser": "^5.39.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
